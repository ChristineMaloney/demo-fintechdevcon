# Copy to `.env` and fill in. `.env` is gitignored.
# server.js loads this file at boot (tiny built-in parser, no dotenv dependency).

PORT=3000

# ─────────────────────────────────────────────────────────────────────
# Payment provider credentials go here once one is integrated. Nothing
# is configured today — the storefront runs standalone.
#
# Whatever gets added, keep it in this file: the app reads config from
# process.env so switching between test and live environments is a
# matter of swapping .env, never editing source.
# ─────────────────────────────────────────────────────────────────────

# Optional — only if you're behind a corporate proxy:
# HTTPS_PROXY=
