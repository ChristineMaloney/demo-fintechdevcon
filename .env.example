# Switchback Systems — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# The server loads `.env` at boot (see loadDotEnv() in server.js), so anything
# added here is available on `process.env` with no code changes.
#
# The J.P. Morgan Payments skills populate these.

PORT=3000

# ─── Auth bypass — mock endpoint only ────────────────────────────────
# When 'true', no JWT is signed and no access token is fetched; requests go
# out unauthenticated. JPM's mock host accepts that and returns canned
# responses. CAT and PROD do not — leave this unset (or 'false') for either,
# and the JPM_* credentials below become required again.
JPM_BYPASS_AUTH=false

# ─── J.P. Morgan Payments — OAuth (jpm-oauth skill) ──────────────────
JPM_CLIENT_ID=
JPM_CERT_PATH=
JPM_PRIVATE_KEY_PATH=

# resource_id from your JPM onboarding email (subject usually contains
# "API Entitlements"). Looks like:
#   JPMC:URI:RS-000000-<FID>-HelixAPIEntitlements...
# CAT and PROD have different resource_ids — set the one for the env you target.
JPM_RESOURCE_ID=

# SHA-1 fingerprint of your JPM certificate, used as the JWT `kid`.
# Derive it with:
#   openssl x509 -in <your-cert>.cer -noout -fingerprint -sha1
# Colons are fine — the auth module strips them and uppercases.
JPM_CERT_THUMBPRINT=

# Optional. JWT lifetime in seconds. Defaults to 15552000 (6 months, the JPM
# CAT sample value) if unset. JPM recommends 28800 (8 hours) for PROD.
JPM_JWT_TTL_SEC=

# ─── J.P. Morgan Payments — Online Payments API ──────────────────────
# Sent as the `merchant-id` header on every Online Payments request.
JPM_MERCHANT_ID=

# Base URL for the Online Payments API, including the version path — e.g.
# https://<host>/api/v2. CAT and PROD are different hosts; confirm the exact
# one for your environment from your onboarding email or the JPM Developer
# Portal. There is no default: guessing wrong either dead-ends or, worse,
# sends a test order to production.
JPM_PAYMENTS_API_URL=
