# Copy to `.env` and fill in. `.env` is gitignored.
# server.js loads this file at boot (tiny built-in parser, no dotenv dependency).

PORT=3000

# ─────────────────────────────────────────────────────────────────────
# Payment provider credentials go here once one is integrated. Nothing
# is configured today — the storefront runs standalone.
#
# Whatever gets added, keep it in this file: the app reads config from
# process.env so switching between test and live environments is a
# matter of swapping .env, never editing source.
# ─────────────────────────────────────────────────────────────────────

# Optional — only if you're behind a corporate proxy:
# HTTPS_PROXY=

# ─────────────────────────────────────────────────────────────────────
# J.P. Morgan Payments API credentials
# Fill in your values. Do NOT commit .env to source control.
# ─────────────────────────────────────────────────────────────────────

JPM_CLIENT_ID=
JPM_CERT_PATH=
JPM_PRIVATE_KEY_PATH=

# resource_id from your JPM onboarding email (subject usually contains
# "API Entitlements"). Looks like:
#   JPMC:URI:RS-000000-<FID>-HelixAPIEntitlements...
# CAT and PROD have different resource_ids — set the one for the env you target.
JPM_RESOURCE_ID=

# SHA-1 thumbprint of your JPM certificate, used as the JWT `kid`.
# Compute it with:
#   openssl x509 -in <your-cert.cer> -noout -fingerprint -sha1
# Colons and lowercase are fine — lib/jpmAuth.js normalizes them.
JPM_CERT_THUMBPRINT=

# JWT lifetime in seconds. Optional — defaults to 15552000 (6 months, the
# JPM sample value). JPM recommends 28800 (8 hours) for PROD.
JPM_JWT_TTL_SEC=15552000

# Only set if your private key is passphrase-protected.
# JPM_KEY_PASSPHRASE=

# Endpoint overrides.
#
# The mock at api-mock.payments.jpmorgan.com behaves like a CAT endpoint
# but takes no credentials, so Checkout calls against it skip the token
# exchange entirely — none of the auth vars above are read. Point this at
# CAT or PROD and auth switches back on automatically. The server prints
# the resolved api and auth hosts at boot.
#
# JPM_OAUTH_TOKEN_URL only applies to CAT/PROD; leave it unset to use
# IDAnywhere at https://idag2.jpmorganchase.com/adfs/oauth2/token
JPM_API_BASE_URL=https://api-mock.payments.jpmorgan.com

# ─── Checkout API ─────────────────────────────────────────────────────
# Merchant ID from Commerce Center. Sent as the `merchantId` header.
# The value below is JPM's documentation sample — fine against the mock,
# which checks nothing. Replace it with your real one for CAT and PROD.
JPM_MERCHANT_ID=996897591058

# Checkout API base. Defaults to ${JPM_API_BASE_URL}/v1 (the mock env).
#   CAT:  https://merchant-api.checkout-cat.merchant.jpmorgan.com/v1
#   PROD: https://merchant-api.checkout.merchant.jpmorgan.com/v1
# JPM_CHECKOUT_API_URL=

# Browser-side Drop-in UI bundle. This is a SEPARATE dial from the API base
# above: JPM ships one bundle per environment and each calls its own
# backend, so the CAT bundle talks to api.checkout-cat.merchant.jpmorgan.com
# no matter where JPM_CHECKOUT_API_URL points. JPM documents only these two
# — there is no published mock bundle, so a mock-issued session token has no
# matching UI to render it.
#   CAT:  https://checkout-cat.merchant.jpmorgan.com/drop-in-ui.mjs (default)
#   PROD: https://checkout.merchant.jpmorgan.com/drop-in-ui.mjs
# JPM_DROPIN_UI_URL=
